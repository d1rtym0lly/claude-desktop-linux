# Unofficial repackaging of the official Claude Desktop Debian build.
# The app itself is downloaded from Anthropic's servers at build time and is
# not redistributed by this repository.
# Version and checksums are updated by scripts/update.sh.

pkgname=claude-desktop
pkgver=4.4212.0
# Upstream (Debian) version as written in the .deb file name.
_debver=4.4212.0
pkgrel=1
pkgdesc="Claude Desktop: Chat, Cowork and Claude Code (official Anthropic app, repackaged from the .deb)"
arch=('x86_64' 'aarch64')
url="https://claude.ai/download"
license=('LicenseRef-Anthropic-Commercial')
depends=(
  'alsa-lib' 'at-spi2-core' 'gtk3' 'libcap-ng' 'libcups' 'libdrm'
  'libnotify' 'libpipewire' 'libseccomp' 'libsecret' 'libxkbcommon' 'mesa'
  'nss' 'xdg-utils'
)
optdepends=(
  'gnome-keyring: keep the sign-in outside KDE (or any other Secret Service provider)'
  'kwallet: keep the sign-in on KDE Plasma'
  'qemu-base: Cowork virtual machine'
  'edk2-ovmf: UEFI firmware for the Cowork virtual machine'
)
options=('!strip' '!debug')

_repo="https://downloads.claude.ai/claude-desktop/apt/stable/pool/main/c/claude-desktop"
source=('claude-desktop-launcher.sh' 'claude-desktop-autostart.sh')
source_x86_64=("${pkgname}_${_debver}_amd64.deb::${_repo}/${pkgname}_${_debver}_amd64.deb")
source_aarch64=("${pkgname}_${_debver}_arm64.deb::${_repo}/${pkgname}_${_debver}_arm64.deb")
noextract=("${source_x86_64[0]%%::*}" "${source_aarch64[0]%%::*}")
sha256sums=('792b4da22aeb0fb2d2fe56bc3ebcb18ddd43fd54f625781d792c5ef8a9981d38' '775f9775f679ea4383969154b9d6642fc7aa2a591efc6c34371764740dd999ea')
sha256sums_x86_64=('4fcf658e0fc895390ab82593287281dfbce261b0ec3ea90060e82d8bfbfd7a84')
sha256sums_aarch64=('7022dc56de30e0beb7fa0a7dc84e09aa00d7f9d4e1b7f93043b32baf75a2f6d8')

prepare() {
  local deb
  case "$CARCH" in
    x86_64)  deb="${pkgname}_${_debver}_amd64.deb" ;;
    aarch64) deb="${pkgname}_${_debver}_arm64.deb" ;;
  esac
  rm -rf deb && mkdir deb
  bsdtar -xf "$deb" -C deb data.tar.\*
  mkdir deb/root
  bsdtar -xf deb/data.tar.* -C deb/root
}

package() {
  cp -a "$srcdir/deb/root/." "$pkgdir/"

  # apt repository entry, its signing key and defaults are Debian-only.
  rm -rf "$pkgdir/etc/apt" "$pkgdir/etc/default" "$pkgdir/usr/share/keyrings"
  rmdir --ignore-fail-on-non-empty "$pkgdir/etc" 2>/dev/null || true

  find "$pkgdir" -name chrome-sandbox -type f -exec chmod 4755 {} +

  # Keep the official entry point and put our launcher in front of it.
  local official="/usr/bin/claude-desktop" app
  if [[ -L $pkgdir$official ]]; then
    app=$(readlink "$pkgdir$official")
    [[ $app == /* ]] || app=$(realpath -m -s "/usr/bin/$app")
    rm "$pkgdir$official"
  elif [[ -f $pkgdir$official ]]; then
    app="/usr/lib/claude-desktop-linux/claude-desktop-official"
    install -Dm755 "$pkgdir$official" "$pkgdir$app"
    rm "$pkgdir$official"
  else
    error "The .deb has no /usr/bin/claude-desktop; the layout changed, see README"
    return 1
  fi

  sed "s|@APP@|$app|" "$srcdir/claude-desktop-launcher.sh" > launcher
  install -Dm755 launcher "$pkgdir/usr/bin/claude-desktop"
  install -Dm755 "$srcdir/claude-desktop-autostart.sh" "$pkgdir/usr/bin/claude-desktop-autostart"

  # Cowork looks for QEMU parts at Debian paths only:
  #   firmware  /usr/share/OVMF/OVMF_CODE_4M.fd  (Arch: /usr/share/OVMF -> edk2,
  #             file is x64/OVMF_CODE.4m.fd from edk2-ovmf)
  #   virtiofsd /usr/libexec/virtiofsd or /usr/bin/virtiofsd (the app ships one)
  if [[ $CARCH == x86_64 ]]; then
    install -d "$pkgdir/usr/share/edk2"
    ln -s x64/OVMF_CODE.4m.fd "$pkgdir/usr/share/edk2/OVMF_CODE_4M.fd"
  fi
  local virtiofsd
  virtiofsd="$(dirname "$app")/resources/virtiofsd"
  if [[ -x $pkgdir$virtiofsd ]]; then
    ln -s "$virtiofsd" "$pkgdir/usr/bin/virtiofsd"
  fi

  # Desktop entries must go through the launcher too.
  local entry
  for entry in "$pkgdir"/usr/share/applications/*.desktop; do
    [[ -f $entry ]] || continue
    sed -i -E 's|^(Exec=)[^ ]*claude[^ ]*|\1/usr/bin/claude-desktop|; s|^(TryExec=).*|\1/usr/bin/claude-desktop|' "$entry"
  done
}
